# Install devDependencies even when NODE_ENV=production.
#
# `next build` needs tailwindcss, postcss and autoprefixer (postcss.config.mjs
# loads them), typescript and @types/* (the build type-checks), and the prisma
# CLI (`prisma generate` runs first). All of those are devDependencies, because
# none of them is needed to *run* the server — only to build it.
#
# npm omits devDependencies whenever NODE_ENV=production, and hosting panels set
# that variable for the whole app, install step included. The result is an
# install that looks like it worked followed by a build that fails on a missing
# Tailwind plugin. This makes the install independent of that variable.
#
# It costs nothing in the Docker image: the runner stage copies only the
# standalone output, never node_modules.
include=dev
