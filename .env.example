# =============================================================================
#  BITSOL AI Assistant — Environment Configuration
#  Designed & Developed by BITSOL MARKETING (https://bitsolmarketing.com)
# =============================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME="BITSOL AI Assistant"
APP_URL=http://localhost:3000
# Public base URL the browser uses (exposed to the client).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://bitsol:bitsol_password@localhost:5432/bitsol_assistant?schema=public

# --- Cache (Redis) ----------------------------------------------------------
# Optional. Without it, rate limiting fails open (allows every request).
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
# Rounds for bcrypt password hashing.
BCRYPT_ROUNDS=12

# --- AI Provider ------------------------------------------------------------
# Which provider powers the assistant.
#   claude  -> Anthropic Claude API            (default, recommended)
#   openai  -> OpenAI-compatible API           (OpenAI, Azure OpenAI, Together, etc.)
#   ollama  -> Local Ollama (OpenAI-compatible endpoint)
#   gemini  -> Google Gemini API
AI_PROVIDER=claude
# Model id passed to the selected provider. Change freely per provider.
AI_MODEL=claude-opus-4-8
# Response length cap. Raise it if answers are being cut off.
AI_MAX_TOKENS=1400
# Optional Claude adaptive thinking (deeper, slower). Keep false for a snappy
# public chat widget.
AI_THINKING=false

# Anthropic (claude)
ANTHROPIC_API_KEY=

# OpenAI-compatible (openai / ollama)
OPENAI_API_KEY=
# Override for Azure/Together/OpenRouter/Ollama, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (gemini)
GEMINI_API_KEY=

# --- Notifications ----------------------------------------------------------
# Every lead, admission inquiry, meeting and ticket queues a notification row.
# A worker reads the `notifications` table and delivers via these channels.

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BITSOL <no-reply@bitsolmarketing.com>"

# SMS gateway
SMS_API_KEY=
SMS_SENDER_ID=BITSOL

# WhatsApp Business API (official Meta API — required for templates/broadcasts)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Google Maps (office location on the contact card)
GOOGLE_MAPS_API_KEY=

# --- Team routing -----------------------------------------------------------
# Where new records are announced. Falls back to SMTP_FROM when unset.
# BITSOL Marketing: leads, quotes, consultations, marketing tickets.
SALES_NOTIFY_EMAIL=sales@bitsolmarketing.com
# BITSOL Institute: admission inquiries, counselling bookings, student support.
ADMISSIONS_NOTIFY_EMAIL=admissions@bitsolinstitute.com

# --- Seed accounts ----------------------------------------------------------
# Used once by `npm run db:seed`. Change the passwords before any real deploy.
SEED_ADMIN_EMAIL=admin@bitsol.local
SEED_ADMIN_PASSWORD=ChangeMe#2024
SEED_STAFF_PASSWORD=ChangeMe#2024

# --- Branding (surfaced in UI/footers) --------------------------------------
NEXT_PUBLIC_BRAND_NAME="BITSOL MARKETING"
NEXT_PUBLIC_BRAND_URL=https://bitsolmarketing.com
NEXT_PUBLIC_BRAND_TAGLINE="Empowering Businesses & Learners with Artificial Intelligence"
